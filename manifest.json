{
  "manifest_version": 3,
  "name": "Sheets Table Layout Formatter",
  "version": "0.1.0",
  "description": "Format a Google Sheets table with one click: borders, filter, header style, rotation, auto-fit, wrap.",
  "permissions": ["debugger", "scripting", "activeTab"],
  "host_permissions": ["https://docs.google.com/spreadsheets/*"],
  "action": {
    "default_title": "Format table layout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
